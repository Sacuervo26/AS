---
import Header from '../components/header-footer/1-Header.astro';
import Footer from '../components/header-footer/5-Footer.astro';
import '../styles/global.css';
import '../styles/alma.css';

interface Props {
  title?: string;
  home?: boolean;
  description?: string;
}
const { title = 'ALMA Studio & Academy', home = false, description = 'Maquillaje y peinado premium a domicilio en Bogotá. Formación profesional en La Escuela de Alma.' } = Astro.props;
const scenes = ['experiencias', 'academia', 'galeria', 'contacto'];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#241b18">
  <link rel="icon" href="/FaviconRosado.png" type="image/png">
  <title>{title}</title>
</head>
<body class="alma">
  <div class="alma-world" aria-hidden="true">
    <div class="alma-world__image"></div>
    {home && scenes.map(scene => (
      <div class="alma-world__image" data-scene={scene} data-source={`/estudio/alma-parallax-${scene}.webp`}></div>
    ))}
    <div class="alma-world__tint"></div>
  </div>
  <a class="alma-skip" href="#contenido">Saltar al contenido</a>
  <Header />
  <main id="contenido" class:list={['alma-main', { 'alma-detail': !home }]}>
    <slot />
  </main>
  <div class="alma-footer"><Footer /></div>
</body>
</html>

<script>
  import '../scripts/alma-scroll';
</script>
