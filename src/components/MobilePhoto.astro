---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'img'> {
  src: string;
}
const props = Astro.props;
const mobile = `/medios/${props.src.split('/').pop()}`;
---
<picture class="alma-picture">
  <source media="(max-width: 700px)" srcset={mobile} type="image/webp" />
  <img {...props} />
</picture>
